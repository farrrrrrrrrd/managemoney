# Telegram Bot Configuration
# Dapatkan HTTP API token gratis dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=RiedutBot
# Mode bot: "polling" (untuk development/lokal) atau "webhook" (otomatis di Vercel serverless)
TELEGRAM_MODE=webhook

# Supabase PostgreSQL Cloud Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DB_BACKEND=supabase

